<h2 class="page-header">Tag: <%= page.tag %></h2>
<section class="post-list">
<% page.posts.sort('date', -1).each(function(post){ %>
  <div class="post-row">
    <a class="post-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
    <span class="post-date"><%= date(post.date, 'MMM D, YYYY') %></span>
  </div>
<% }); %>
</section>
