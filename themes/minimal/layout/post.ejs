<article>
  <h2 class="post-header"><%= page.title %></h2>
  <%
    var plain = page.content.replace(/<[^>]*>/g, ' ').replace(/&[a-z]+;/gi, ' ');
    var words = plain.split(/\s+/).filter(function(w){ return w.length > 0; }).length;
    var minutes = Math.max(1, Math.round(words / 220));
  %>
  <div class="post-meta">
    <%= date(page.date, 'MMMM D, YYYY') %> &middot; <%= minutes %> min read<% if (page.tags && page.tags.length) { page.tags.each(function(tag){ %> <a class="meta-tag" href="<%- url_for(tag.path) %>"><%= tag.name %></a><% }); } %>
  </div>
  <div class="post-content"><%- page.content %></div>
</article>

<% if (page.prev || page.next) { %>
<nav class="post-nav">
  <% if (page.next) { %>
    <a class="post-nav-prev" href="<%- url_for(page.next.path) %>">
      <span class="post-nav-label">&larr; Older</span>
      <span class="post-nav-title"><%= page.next.title %></span>
    </a>
  <% } else { %>
    <span></span>
  <% } %>
  <% if (page.prev) { %>
    <a class="post-nav-next" href="<%- url_for(page.prev.path) %>">
      <span class="post-nav-label">Newer &rarr;</span>
      <span class="post-nav-title"><%= page.prev.title %></span>
    </a>
  <% } %>
</nav>
<% } %>
